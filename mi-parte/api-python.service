[Unit]
Description=API Python - Seminario de Sistemas 1 (Instancia-1)
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/api-python
ExecStart=/home/azureuser/api-python/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
